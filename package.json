{
  "name": "buddo",
  "version": "1.0.0",
  "private": true,
  "description": "Buddo \u2014 a free, local-first AI coding agent. No API keys.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/media",
    "packages/server",
    "packages/cli",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build -w apps/web",
    "start": "node packages/cli/bin/buddo.js web",
    "cli": "node packages/cli/bin/buddo.js",
    "link": "cd packages/cli && npm link",
    "desktop": "cd apps/desktop && npm install && npm start",
    "test": "node --test packages/core/test/*.test.js packages/media/test/*.test.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "MIT"
}
